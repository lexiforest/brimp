{
  "name": "brimp-development",
  "private": true,
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "format": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore \"**/*.{js,mjs,cjs}\"",
    "format:check": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore \"**/*.{js,mjs,cjs}\""
