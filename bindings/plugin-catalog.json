{
  "storage": {
    "installers": {
      "node": "storagePlugin",
      "python": "storage"
    },
    "capabilities": [
      "Storage",
      "IndexedDB transactions",
      "Cache"
    ],
    "limitations": [
      "Memory only; resets on navigation",
      "No shared-origin IndexedDB, storage events or OPFS"
    ],
    "lifetime": "realm",
    "options": {}
  },
  "canvas": {
    "installers": {
      "node": "canvasPlugin",
      "python": "canvas"
    },
    "capabilities": [
      "Canvas state",
      "ImageData",
      "Configured readback"
    ],
    "limitations": [
      "No rasterization, fonts or image decoding",
      "Mock data URL is not an image"
    ],
    "lifetime": "realm",
    "options": {
      "rgba": {
        "default": [
          0,
          0,
          0,
          0
        ]
      },
      "characterWidth": {
        "default": 0.5,
        "python": "character_width"
      }
    }
  },
  "services": {
    "installers": {
      "node": "servicesPlugin",
      "python": "services"
    },
    "capabilities": [
      "Realm-local locks",
      "Configured navigator/device values"
