      "Custom backend factory"
    ],
    "limitations": [
      "Not localStorage or IndexedDB",
      "Durability depends on explicit backend",
      "Opaque origins rejected"
    ],
    "lifetime": "session or explicit backend",
    "options": {
      "backendFactory": {
        "default": "session-memory",
        "python": "backend_factory",
        "hostOnly": true
      }
