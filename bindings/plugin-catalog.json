      "connection_downlink_mbps": {
        "default": 0
      },
      "connection_effective_type": {
        "default": "4g"
      },
      "connection_save_data": {
        "default": false
      },
      "notification_permission": {
        "default": "denied"
      },
      "permissions_enabled": {
        "default": true
